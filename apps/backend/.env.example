NODE_ENV=local
PORT=3000
API_PREFIX=api/v1

DATABASE_URL=postgresql://flashtalk:flashtalk@127.0.0.1:5433/flashtalk?schema=public

JWT_ACCESS_SECRET=change-me-access-secret-dev-only
JWT_REFRESH_SECRET=change-me-refresh-secret-dev-only
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=128

EMAIL_PROVIDER=console
EMAIL_FROM=noreply@flashtalk.local
EMAIL_VERIFICATION_TTL=600
EMAIL_RESEND_INTERVAL=60
EMAIL_CODE_MAX_ATTEMPTS=5
EMAIL_CODE_DAILY_LIMIT=10

S3_ENDPOINT=
S3_BUCKET=flashtalk-avatars
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=ap-northeast-1

CHAT_SESSION_DURATION_SECONDS=600

PAIR_COOLDOWN_STANDARD_SECONDS=86400
PAIR_COOLDOWN_POST_CHAT_SECONDS=604800

SOCKET_DISCONNECT_GRACE_SECONDS=30

CORS_ORIGINS=*
